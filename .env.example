# TEMPLATE ONLY — this file IS committed to git.
#
# Never put real values here. Copy it to .env.local (which is gitignored) and
# fill that in instead:
#
#   cp .env.example .env.local

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Only needed if the deployment URL cannot be inferred (most Vercel setups can).
# AUTH_URL=https://your-app.vercel.app

# ---------------------------------------------------------------------------
# Database (Neon Postgres)
# ---------------------------------------------------------------------------
# The POOLED connection string from the Neon dashboard — the host contains
# "-pooler". Neon's snippet offers a dozen other variables (POSTGRES_*, PG*,
# DATABASE_URL_UNPOOLED); this app uses none of them, so paste only this one.
DATABASE_URL=

# ---------------------------------------------------------------------------
# Gemini API (Google AI Studio)
# ---------------------------------------------------------------------------
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Current GA Flash model. Override to pin an older one.
GEMINI_MODEL=gemini-3.7-flash

# Set to "true" ONLY once the key's project is actually on the PAID tier
# (aistudio.google.com/projects — the "Billing Tier" column).
#
# This is not a formality. On the free tier Google uses submitted content to
# develop its products and human reviewers may read it — which is incompatible
# with processing other people's registration sheets. The key looks identical
# either way and the API never tells you which tier you are on, so only a person
# can confirm this.
#
# Until it is "true", /privacy tells users not to upload real sheets. Do not
# flip it to make that warning go away.
GEMINI_PAID_TIER_CONFIRMED=false

# ---------------------------------------------------------------------------
# Limits
# ---------------------------------------------------------------------------
# Applies to both shapes of upload: pages in a PDF, or photos of separate
# sheets. One photo is one page, and either way an extraction costs one credit.
MAX_PAGES=10

# 4 MB, deliberately under Vercel's hard 4.5 MB request-body cap so the
# rejection is ours (with a helpful message) rather than a raw platform 413.
#
# This is the cap on the WHOLE upload, not per file. Phone photos would blow
# through it in twos, so the browser re-encodes them down to roughly 190 DPI
# before sending; raising this number does not change that behaviour, since the
# platform cap is the real ceiling.
MAX_UPLOAD_BYTES=4000000
